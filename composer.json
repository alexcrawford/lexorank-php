{
    "name": "alexcrawford/lexorank-php",
    "description": "PHP Implementation of JIRA's LexoRank algorithm.",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Crawford",
            "email": "alex@kick.digital"
        }
    ],
    "type": "library",
    "require": {
        "php": "^8.1",
        "webmozart/assert": "^1.11 || ^2.0"
    },
    "require-dev": {
        "doctrine/coding-standard": "^14.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.5 || ^13.0",
        "psalm/plugin-phpunit": "^0.19.7",
        "vimeo/psalm": "^6.13"
    },
    "autoload": {
        "psr-4": {
            "AlexCrawford\\LexoRank\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexCrawford\\LexoRank\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
